{
    "name": "rasuvaeff/yii3-utm-db",
    "description": "Portable yiisoft/db storage for rasuvaeff/yii3-utm: append-only attribution journal with race-safe deduplication, retention and erasure",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "utm",
        "attribution",
        "marketing",
        "analytics",
        "yii3",
        "yiisoft-db",
        "migration",
        "first-touch",
        "retention"
    ],
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "homepage": "https://github.com/rasuvaeff/yii3-utm-db",
    "support": {
        "issues": "https://github.com/rasuvaeff/yii3-utm-db/issues",
        "source": "https://github.com/rasuvaeff/yii3-utm-db"
    },
    "require": {
        "php": "8.3 - 8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "psr/clock": "^1.0",
        "rasuvaeff/yii3-utm": "^1.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "yiisoft/db": "^2.0",
        "yiisoft/db-migration": "^2.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.33",
        "maglnet/composer-require-checker": "^4.17",
        "nyholm/psr7": "^1.8",
        "rector/rector": "^2.4",
        "roave/backward-compatibility-check": "^8.0",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.25",
        "vimeo/psalm": "^6.16",
        "yiisoft/cache": "^3.2",
        "yiisoft/db-sqlite": "^2.0",
        "yiisoft/di": "^1.2.1",
        "yiisoft/injector": "^1.2",
        "yiisoft/test-support": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\Yii3UtmDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rasuvaeff\\Yii3UtmDb\\Benchmarks\\": "benchmarks/",
            "Rasuvaeff\\Yii3UtmDb\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "ext-bcmath": "1.0.0",
            "ext-intl": "1.0.0"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        },
        "config-plugin-options": {
            "source-directory": "config"
        }
    },
    "scripts": {
        "bc-check": "roave-backward-compatibility-check",
        "bench": "testo --suite=Benchmarks -vv",
        "build": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@require-checker",
            "@cs",
            "@psalm",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --diff --config=.php-cs-fixer.php",
        "mutation": "infection --threads=max",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "release-check": [
            "@build",
            "@rector",
            "@bc-check"
        ],
        "require-checker": "composer-require-checker check composer.json",
        "test": "testo --suite=Unit",
        "test:coverage": "testo --suite=Unit --coverage --coverage-clover=build/coverage.xml",
        "test:coverage:ci": "testo --suite=Unit --coverage-clover=build/coverage.xml",
        "test:integration": "testo --suite=Integration"
    }
}
